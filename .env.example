# WhatsApp click-to-chat: se abre el mensaje preparado para confirmarlo manualmente.
# Teléfono inicial para nuevas cuentas, en formato E.164.
DEFAULT_WHATSAPP_PHONE=

# Persistencia y despliegue. En producción usar un volumen persistente y HTTPS.
DATA_DIR=./data
NODE_ENV=development

# Proveedor secundario opcional para cotizaciones prioritarias (Twelve Data).
# Si no hay clave, la app usa Yahoo Finance y luego la última cotización válida en caché.
TWELVE_DATA_API_KEY=

# Puerto HTTP local (opcional).
PORT=3000
